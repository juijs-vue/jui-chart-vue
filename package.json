{
  "name": "jui-chart-vue",
  "private": true,
  "version": "0.1.0",
  "description": "Vue 3 <Chart> component wrapping jui-graph-ts's real Builder/Axis engine (Phase 1: foundation).",
  "type": "module",
  "license": "MIT",
  "author": "search5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juijs-vue/jui-chart-vue.git"
  },
  "homepage": "https://github.com/juijs-vue/jui-chart-vue#readme",
  "bugs": {
    "url": "https://github.com/juijs-vue/jui-chart-vue/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "chart",
    "component-library"
  ],
  "main": "./dist-lib/jui-chart-vue.umd.js",
  "module": "./dist-lib/jui-chart-vue.es.js",
  "exports": {
    ".": {
      "import": "./dist-lib/jui-chart-vue.es.js",
      "require": "./dist-lib/jui-chart-vue.umd.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -p tsconfig.lib.json --noEmit && vite build -c vite.lib.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jui-graph-ts": "file:../jui-graph-ts",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
